# ============================================================
# Mongoose CGI Server - MSVC Makefile
#
# 用法 (在 Developer Command Prompt 中):
#   nmake /f Makefile.msvc
#   nmake /f Makefile.msvc clean
#   nmake /f Makefile.msvc run
# ============================================================

CC      = cl
CFLAGS  = /nologo /W3 /O2 /I. /D_CRT_SECURE_NO_WARNINGS
LDFLAGS = ws2_32.lib

SRCS = main.c \
       mongoose.c \
       router.c \
       modules\mod_user.c \
       modules\mod_device.c \
       modules\mod_system.c

TARGET = cgi_server.exe

all: $(TARGET)

$(TARGET): $(SRCS)
	$(CC) $(CFLAGS) /Fe:$(TARGET) $(SRCS) /link $(LDFLAGS)
	@echo Build OK -^> $(TARGET)

run: $(TARGET)
	$(TARGET)

clean:
	-del /q *.obj modules\*.obj $(TARGET) 2>nul
	@echo Clean done.
